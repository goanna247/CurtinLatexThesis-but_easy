% ----------- Generates title section from preamble information -----------
\newcommand{\TitleSection}[0] {
  \newcommand{\HRule}{\rule{\linewidth}{0.5mm}} 
  \fontsize{12pt}{14pt}\selectfont

  \center
  \textbf{\@Title} 
  \textbf{\@Unitcodee \@Unitname extended abstract}

  \text{\@Author}

  \text{\@Degree \@Street}
  \textit{E-mail: \@Email}
}

\newcommand{\ExtendedAbstract}{%
  \clearpage
  \thispagestyle{plain}
  {\fontsize{12pt}{14pt}\selectfont
    \FrontSection{Abstract}
    \begin{flushleft}
      \input{abstract.tex}
    \end{flushleft}
  }%
  \newpage
}

%Has a default title or user can put in their own
\NewDocumentCommand{\EA_Introduction}{O{EA_Introduction}}{
  \clearpage
  \MainMatter
  {\fontsize{12pt}{14pt}\selectfont
  \begin{flushleft}
      \section*{#1} %Ensures that the contents doesnt mess with the number formatting
      \refstepcounter{section}
      \addcontentsline{toc}{section}{\thesection\space #1}
      \input{EA_Introduction.tex}
    \end{flushleft}
  }%
  \newpage
}

