% ======================================================
% \CodeSideBySide
%   #1 file1
%   #2 file2
%   #3 caption1
%   #4 caption2
%   #5 overall caption
%   #6 overall label
%   #7 language1
%   #8 language2
% ======================================================
\newcommand{\CodeSideBySide}[8]{%
  \begin{figure}[H]\centering
    \begin{minipage}[t]{0.48\linewidth}
      \begin{tcolorbox}[annaTC]
        \lstinputlisting[
          style=annaListing,
          language={#7},
          caption={#3},
          inputencoding=\CodeInputEnc,
          captionpos=b
        ]{#1}
      \end{tcolorbox}
    \end{minipage}\hfill
    \begin{minipage}[t]{0.48\linewidth}
      \begin{tcolorbox}[annaTC]
        \lstinputlisting[
          style=annaListing,
          language={#8},
          inputencoding=\CodeInputEnc,
          caption={#4},
          captionpos=b
        ]{#2}
      \end{tcolorbox}
    \end{minipage}
    \caption{#5}
    \label{#6}
  \end{figure}%
}

% ======================================================
% \CodeStacked
%   #1 file1
%   #2 file2
%   #3 caption1
%   #4 caption2
%   #5 overall caption
%   #6 overall label
%   #7 language1
%   #8 language2
% ======================================================
\newcommand{\CodeStacked}[8]{%
  \begin{figure}[H]\centering
    % Top code block
    \lstinputlisting[
      style=annaListing,
      language={#7},
      inputencoding=\CodeInputEnc,
      caption={#3},
      captionpos=b
    ]{#1}

    \vspace{1em}

    % Bottom code block
    \lstinputlisting[
      style=annaListing,
      language={#8},
      inputencoding=\CodeInputEnc,
      caption={#4},
      captionpos=b
    ]{#2}

    \caption{#5}
    \label{#6}
  \end{figure}%
}


% ======================================================
% \SingleCode
%   #1 file
%   #2 language
%   #3 caption1
%   #4 label
% ======================================================
\newcommand{\SingleCode}[4]{%
  \begin{figure}[H]\centering
    \lstinputlisting[
      style=annaListing,
      language={#2},
      inputencoding=\CodeInputEnc,
      caption={#3},
      captionpos=b
    ]{#1}
    \label{#4}
  \end{figure}%
}

