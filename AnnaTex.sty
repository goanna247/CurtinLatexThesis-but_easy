\newcommand{\NoPageNumbers}{%
  \clearpage
  \pagenumbering{gobble}% no printing
}

\newcommand{\FrontMatter}{%
  \clearpage
  \pagenumbering{roman}
  \setcounter{page}{1}
}

\newcommand{\MainMatter}{%
  \clearpage
  \pagenumbering{arabic}
  \setcounter{page}{1}
}

% ----------- Generates title page from preamble information -----------
\newcommand{\TitlePage}[0] {
  \newcommand{\HRule}{\rule{\linewidth}{0.5mm}} 
  \fontsize{12pt}{14pt}\selectfont
  \NoPageNumbers

  \center
  \vspace*{3cm}

  \textit{\@Title}\\[2cm]

  \vspace{4cm}

  \textit{\@Author}\\
  \textit{\@AuthorID}\\
  \vspace{9cm}

  \text{{\@Degree} Project Thesis}\\
  \text{\@School}\\
  \text{Curtin University}\\

  \vspace{0.5cm}

  \text{\@Semester}
  \vfill
  \newpage
}

% ----------- Generates the default introductory letter from preamble info -----------
\newcommand{\IntroductoryLetter}[0] {
  \NoPageNumbers
  \fontsize{12pt}{14pt}\selectfont

  \vspace*{2cm}

  % ---------- Sender address (top right) ----------
  \begin{flushright}
    \@Street,\\
    \@Suburb,\\
    WA \@Postcode\\[1cm]
    \today
  \end{flushright}

  \vspace{2cm}

  \begin{flushleft}
    
  
  % ---------- Recipient ----------
  The Head\\
  \@School,\\
  Curtin University,\\
  Kent Street,\\
  Bentley,\\
  WA 6102

  \vspace{2cm}

  Dear Sir,

  \vspace{1cm}

  I submit this thesis entitled ``\textit{\@Title}'', based on
  {\@Unitcode} \@Unitname~1 and
  {\@Unitcodee} \@Unitname~2, undertaken
  by me as part-requirement for the degree of \@Degree.

  \vspace{0.8cm}

  Yours faithfully,

  \vspace{3cm}

  \@Author\\
  \@AuthorID
  \end{flushleft}
}

% ----------- generates acknowledgment page from .tex file -----------
\newcommand{\Acknowledgements}{%
  \clearpage
  \FrontMatter
  \thispagestyle{plain}
  {\fontsize{12pt}{14pt}\selectfont
    \FrontSection{Acknowledgements}
    \begin{flushleft}
      \input{acknowledgements.tex}
    \end{flushleft}
  }%
  \newpage
}

\newcommand{\Abstract}{%
  \clearpage
  \thispagestyle{plain}
  {\fontsize{12pt}{14pt}\selectfont
    \FrontSection{Abstract}
    \begin{flushleft}
      \input{abstract.tex}
    \end{flushleft}
  }%
  \newpage
}

\newcommand{\Nomenclature}{%
  \clearpage
  \thispagestyle{plain}
  {\fontsize{12pt}{14pt}\selectfont
    \FrontSection{Nomenclature}
    \TableFromCSV{nomenclature.csv}
  }%
  \newpage
}

\newcommand{\TableFromCSV}[1]{%
  \begin{center}
    \begin{longtable}{
      >{\centering\arraybackslash}p{4.9cm}|
      >{\centering\arraybackslash}p{4.9cm}|
      >{\centering\arraybackslash}p{4.9cm}
    }

    \textsf{\textbf{Symbol}} & \textsf{\textbf{Title}} & \textsf{\textbf{Unit(s)}} \\
    \hline
    \endfirsthead

    \textsf{\textbf{Symbol}} & \textsf{\textbf{Title}} & \textsf{\textbf{Unit(s)}} \\
    \hline
    \endhead

    \csvreader[
      separator=comma,
      head to column names,
      late after line=\\
    ]{nomenclature.csv}{}{%
      \csvcoli & \csvcolii & \csvcoliii
    }

    \end{longtable}
  \end{center}
}


