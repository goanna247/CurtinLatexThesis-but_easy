% --- Listings default look ---
\lstdefinestyle{annaListing}{
  numbers=left,
  numberstyle=\tiny\color{gray!70},
  numbersep=8pt,
  basicstyle=\ttfamily\small,
  keywordstyle=\bfseries\color{blue!60!black},
  commentstyle=\itshape\color{gray!70},
  stringstyle=\color{green!40!black},
  breaklines=true,
  showstringspaces=false,
  tabsize=2
}

% --- tcolorbox default look ---
\tcbset{
  annaTC/.style={
    enhanced,
    breakable,
    frame hidden,
    boxrule=0.4pt,
    colback=gray!4,
    colframe=gray!60,
    arc=2mm,
    sharp corners=all,
    left=6pt,right=6pt,top=6pt,bottom=6pt
  }
}

